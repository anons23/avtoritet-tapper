package __PACKAGE__;

import android.app.Activity;
import android.util.Log;

import androidx.annotation.NonNull;
import androidx.annotation.Nullable;

import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;

import com.yandex.mobile.ads.common.AdError;
import com.yandex.mobile.ads.common.AdRequest;
import com.yandex.mobile.ads.common.AdRequestError;
import com.yandex.mobile.ads.common.ImpressionData;
import com.yandex.mobile.ads.interstitial.InterstitialAd;
import com.yandex.mobile.ads.interstitial.InterstitialAdEventListener;
import com.yandex.mobile.ads.interstitial.InterstitialAdLoadListener;
import com.yandex.mobile.ads.interstitial.InterstitialAdLoader;
import com.yandex.mobile.ads.rewarded.Reward;
import com.yandex.mobile.ads.rewarded.RewardedAd;
import com.yandex.mobile.ads.rewarded.RewardedAdEventListener;
import com.yandex.mobile.ads.rewarded.RewardedAdLoadListener;
import com.yandex.mobile.ads.rewarded.RewardedAdLoader;

@CapacitorPlugin(name = "YandexAds")
public class YandexAdsPlugin extends Plugin {
    private static final String TAG = "YandexAdsPlugin";

    private boolean busy = false;
    private RewardedAdLoader rewardedLoader;
    private RewardedAd rewardedAd;
    private InterstitialAdLoader interstitialLoader;
    private InterstitialAd interstitialAd;

    @Override
    public void load() {
        super.load();
        try {
            Class<?> mobileAds = Class.forName("com.yandex.mobile.ads.common.MobileAds");
            java.lang.reflect.Method init = null;
            for (java.lang.reflect.Method m : mobileAds.getMethods()) {
                if ("initialize".equals(m.getName()) && m.getParameterTypes().length >= 1) {
                    init = m;
                    break;
                }
            }
            if (init != null) {
                Class<?>[] pts = init.getParameterTypes();
                if (pts.length == 2 && Runnable.class.isAssignableFrom(pts[1])) {
                    init.invoke(null, getContext(), new Runnable() {
                        @Override
                        public void run() {
                            Log.i(TAG, "MobileAds initialized");
                        }
                    });
                } else if (pts.length == 1) {
                    init.invoke(null, getContext());
                }
            }
        } catch (Throwable t) {
            Log.w(TAG, "MobileAds.initialize skipped: " + t.getMessage());
        }
    }

    @PluginMethod
    public void showRewardedAd(final PluginCall call) {
        final String blockId = call.getString("blockId");
        if (blockId == null || blockId.trim().isEmpty()) {
            call.reject("rewarded blockId is empty");
            return;
        }
        if (busy) {
            call.reject("ad already in progress");
            return;
        }
        busy = true;
        final Activity activity = getActivity();
        if (activity == null) {
            busy = false;
            call.reject("activity is null");
            return;
        }
        activity.runOnUiThread(new Runnable() {
            @Override
            public void run() {
                try {
                    cleanupRewarded();
                    rewardedLoader = new RewardedAdLoader(getContext());
                    AdRequest request = new AdRequest.Builder(blockId).build();
                    rewardedLoader.loadAd(request, new RewardedAdLoadListener() {
                        @Override
                        public void onAdLoaded(@NonNull final RewardedAd ad) {
                            rewardedAd = ad;
                            final boolean[] rewardEarned = new boolean[] { false };
                            ad.setAdEventListener(new RewardedAdEventListener() {
                                @Override public void onAdShown() {}
                                @Override public void onAdFailedToShow(@NonNull AdError error) {
                                    cleanupRewarded();
                                    busy = false;
                                    call.reject("show failed");
                                }
                                @Override public void onAdDismissed() {
                                    JSObject result = new JSObject();
                                    result.put("rewarded", rewardEarned[0]);
                                    cleanupRewarded();
                                    busy = false;
                                    call.resolve(result);
                                }
                                @Override public void onAdClicked() {}
                                @Override public void onAdImpression(@Nullable ImpressionData data) {}
                                @Override public void onRewarded(@NonNull Reward reward) {
                                    rewardEarned[0] = true;
                                }
                            });
                            try { ad.show(activity); }
                            catch (Throwable showErr) {
                                cleanupRewarded();
                                busy = false;
                                call.reject("show error");
                            }
                        }
                        @Override
                        public void onAdFailedToLoad(@NonNull AdRequestError error) {
                            cleanupRewarded();
                            busy = false;
                            call.reject("load failed: " + error.getCode() + " " + error.getDescription());
                        }
                    });
                } catch (Throwable t) {
                    cleanupRewarded();
                    busy = false;
                    call.reject("setup error: " + t.getMessage());
                }
            }
        });
    }

    @PluginMethod
    public void showInterstitialAd(final PluginCall call) {
        final String blockId = call.getString("blockId");
        if (blockId == null || blockId.trim().isEmpty()) {
            call.reject("interstitial blockId is empty");
            return;
        }
        if (busy) {
            call.reject("ad already in progress");
            return;
        }
        busy = true;
        final Activity activity = getActivity();
        if (activity == null) {
            busy = false;
            call.reject("activity is null");
            return;
        }
        activity.runOnUiThread(new Runnable() {
            @Override
            public void run() {
                try {
                    cleanupInterstitial();
                    interstitialLoader = new InterstitialAdLoader(getContext());
                    AdRequest request = new AdRequest.Builder(blockId).build();
                    interstitialLoader.loadAd(request, new InterstitialAdLoadListener() {
                        @Override
                        public void onAdLoaded(@NonNull final InterstitialAd ad) {
                            interstitialAd = ad;
                            ad.setAdEventListener(new InterstitialAdEventListener() {
                                @Override public void onAdShown() {}
                                @Override public void onAdFailedToShow(@NonNull AdError error) {
                                    cleanupInterstitial();
                                    busy = false;
                                    call.reject("show failed");
                                }
                                @Override public void onAdDismissed() {
                                    cleanupInterstitial();
                                    busy = false;
                                    call.resolve();
                                }
                                @Override public void onAdClicked() {}
                                @Override public void onAdImpression(@Nullable ImpressionData data) {}
                            });
                            try { ad.show(activity); }
                            catch (Throwable showErr) {
                                cleanupInterstitial();
                                busy = false;
                                call.reject("show error");
                            }
                        }
                        @Override
                        public void onAdFailedToLoad(@NonNull AdRequestError error) {
                            cleanupInterstitial();
                            busy = false;
                            call.reject("load failed: " + error.getCode() + " " + error.getDescription());
                        }
                    });
                } catch (Throwable t) {
                    cleanupInterstitial();
                    busy = false;
                    call.reject("setup error: " + t.getMessage());
                }
            }
        });
    }

    private void cleanupRewarded() {
        try { if (rewardedAd != null) rewardedAd.setAdEventListener(null); } catch (Throwable ignored) {}
        rewardedAd = null;
        rewardedLoader = null;
    }

    private void cleanupInterstitial() {
        try { if (interstitialAd != null) interstitialAd.setAdEventListener(null); } catch (Throwable ignored) {}
        interstitialAd = null;
        interstitialLoader = null;
    }

    @Override
    protected void handleOnDestroy() {
        cleanupRewarded();
        cleanupInterstitial();
        super.handleOnDestroy();
    }
}
